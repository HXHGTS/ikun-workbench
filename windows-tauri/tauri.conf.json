{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ikun新媒体制作中心",
  "mainBinaryName": "ikun",
  "version": "1.0.0",
  "identifier": "ai.ikunattacker.ikunwb",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "ikun新媒体制作中心",
        "width": 1380,
        "height": 920,
        "center": true,
        "additionalBrowserArgs": "--disable-web-security"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": "none",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}